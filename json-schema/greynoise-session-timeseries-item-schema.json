{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-evangelist.github.io/greynoise/json-schema/greynoise-session-timeseries-item-schema.json",
  "title": "SessionTimeseriesItem",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "The field value for this group.",
      "example": "192.168.1.1"
    },
    "count": {
      "type": "integer",
      "description": "Total sessions for this group.",
      "example": 150
    },
    "timeseries": {
      "type": "array",
      "description": "Timeseries data for this group.",
      "items": {
        "$ref": "./greynoise-session-timeseries-point-schema.json#"
      },
      "example": []
    }
  }
}