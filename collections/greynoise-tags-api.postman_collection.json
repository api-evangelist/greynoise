          "name": "List Tags",
          "request": {
            "name": "List Tags",
            "description": {
              "content": "Retrieve a list of tags with their metadata. Supports filtering by name, slug, and CVE.\n\nThis endpoint returns tag information including ID, name, slug, category, intention,\ndescription, references, CVEs, and related tags.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "tags"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filter tags by name (partial match)"
                },
                {
                  "disabled": false,
                  "key": "slug",
                  "value": "<string>",
                  "description": "Filter tags by slug (exact match)"
                },
                {
                  "disabled": false,
                  "key": "cve",
                  "value": "<string>",
                  "description": "Filter tags by associated CVE"
                }
              ],
              "variable": []
            },
