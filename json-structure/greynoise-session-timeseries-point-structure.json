{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://api-evangelist.github.io/greynoise/json-structure/greynoise-session-timeseries-point-structure.json",
  "name": "SessionTimeseriesPoint",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "Timestamp for this data point.",
      "example": "2025-01-01T00:00:00Z"
    },
    "count": {
      "type": "int32",
      "description": "Number of sessions in this time bucket.",
      "example": 42
    }
  }
}