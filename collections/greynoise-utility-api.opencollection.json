{
  "opencollection": "1.0.0",
  "info": {
    "name": "GreyNoise Callback Utility API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Utility",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.greynoise.io/ping"
          },
          "docs": "Provides a simple endpoint to check GreyNoise status and GreyNoise\nAPI access\n"
        }
      ]
    }
  ],
  "bundled": true
}